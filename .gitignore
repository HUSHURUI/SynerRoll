# ========================
# 依赖目录（自动生成，体积大）
# ========================
node_modules/

# ========================
# Nuxt 构建产物（自动生成）
# ========================
.nuxt/
.output/
dist/

# ========================
# Claude Code 工作文件
# ========================
.claude/

# ========================
# Julia 后端数据（运行时产生，不应入库）
# ========================
backend/data/tasks/
backend/data/tasks.db
backend/data/capacity-planning/
backend/data/capacity-planning.db
backend/test/

# ========================
# Julia 依赖锁文件（按需决定，通常不提交 Manifest）
# ========================
backend/Manifest.toml

# ========================
# 操作系统垃圾文件
# ========================
# Windows
Thumbs.db
Desktop.ini
*.lnk
# macOS
.DS_Store
._*

# ========================
# 编辑器 / IDE 配置
# ========================
.vscode/
.idea/
*.swp
*.swo
*~

# ========================
# 环境变量（含密钥，绝对不能提交）
# ========================
.env
.env.local
.env.*.local

# ========================
# 日志文件
# ========================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ========================
# 备份和临时文件
# ========================
backup_*/
*.bak
*.tmp

# ========================
# 压缩包（不应放入 Git，体积太大）
# ========================
*.zip
*.tar.gz
*.rar

# ========================
# Python 工具脚本的缓存
# ========================
__pycache__/
*.pyc
